# ==========================================
# Secure Software Update System - .gitignore
# ==========================================

# ──────────────────────────────────────────
# 1. Python Artifacts
# ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
eggs/
.eggs/

# ──────────────────────────────────────────
# 2. Virtual Environments
# ──────────────────────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
conda-meta/

# ──────────────────────────────────────────
# 3. Testing & Coverage
# ──────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.cache/
pytest.xml
coverage.xml

# ──────────────────────────────────────────
# 4. Build & Distribution Output
# ──────────────────────────────────────────
dist/
build/

# ──────────────────────────────────────────
# 5. Secrets & Private Keys
#    NEVER commit private keys or TLS secrets.
#    Public key (publisher_public.pem) and CA/server
#    certs ARE tracked — clients need them for trust.
# ──────────────────────────────────────────

# Blanket-ignore every file in keys/ …
keys/*
# … except the gitkeep placeholder and the public key
!keys/.gitkeep
!keys/publisher_public.pem

# Blanket-ignore every file in certs/ …
certs/*
# … except the gitkeep placeholder and the files clients/server need
!certs/.gitkeep
!certs/ca.crt
!certs/server.crt

# Ignore every file in client/trusted_keys/ and client/trusted_certs/
# (populated at runtime from keys/ and certs/)
client/trusted_keys/*
!client/trusted_keys/.gitkeep
client/trusted_certs/*
!client/trusted_certs/.gitkeep

# Extra safety net: never track loose private-key files anywhere in the tree
*.key
attacker_private.pem
rogue_ca.key
rogue_server.key

# ──────────────────────────────────────────
# 6. Runtime Databases & State
# ──────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
server/database/*.db
server/database/*.db-journal

# Client runtime storage (populated during operation)
client/storage/*
!client/storage/.gitkeep
client/storage/state.json
client/storage/downloads/
client/storage/staged/
client/storage/backup/

# DemoApp runtime state
demoapp/state.json

# DemoApp temporary install directories
demoapp/.staging/
demoapp/.backup/

# ──────────────────────────────────────────
# 7. Generated Packages & Release Metadata
#    ZIPs are reproducible from source; don't
#    bloat the repo with binary blobs.
# ──────────────────────────────────────────
storage/packages/*.zip
storage/releases/*.json
!storage/releases/.gitkeep

# ──────────────────────────────────────────
# 8. Screenshots & Visual Artifacts
#    Generated by scripts/take_screenshots.py
# ──────────────────────────────────────────
docs/screenshots/

# ──────────────────────────────────────────
# 9. Audit & Report Artifacts
#    Root-specific rule: keep report.md local,
#    do not commit or push to Git.
# ──────────────────────────────────────────
/report.md
audit_*.json
EVIDENCE_REPORT.md



# ──────────────────────────────────────────
# 10. Temporary & Partial Files
# ──────────────────────────────────────────
*.tmp
*.temp
*.part
*.swp
*~

# ──────────────────────────────────────────
# 11. Logs & Runtime Telemetry
# ──────────────────────────────────────────
*.log
logs/
*.pid

# ──────────────────────────────────────────
# 12. OS & IDE Specific Files
# ──────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ──────────────────────────────────────────
# 13. Environment Variable Files
# ──────────────────────────────────────────
.env
.env.*
!.env.example
